<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Storage access is required to read ES-DE's es_log.txt and, later, media files.
        This is deliberately minimal for this initial slice: a hardcoded log path (see
        AppContainer) and manifest permission declarations only. Runtime permission
        requests - including the Android 11+ "All Files Access" flow - are not
        implemented yet. That is one of the iterative pieces described in CLAUDE.md,
        not part of this initial base app.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Update checker: fetches release info from the GitHub API and downloads the
         release APK (see GitHubUpdateRepository / CLAUDE.md's network-layer carve-out). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Update checker: lets the user grant "install unknown apps" for this app
         specifically, to install the downloaded update APK (see InstallUnknownAppsPermission). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Thor Settings > Task Killer: the confirmation buzz once a held BACK button reaches
         the force-quit threshold (see data/thor/Vibration.kt). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- SystemStatus/ClockAndSystemStatus FAB: Wifi connectivity and Bluetooth connection
         state (see AndroidSystemStatusRepository). ACCESS_NETWORK_STATE/ACCESS_WIFI_STATE are
         normal permissions (no runtime prompt). BLUETOOTH/BLUETOOTH_ADMIN are normal
         permissions needed only pre-API-31 for adapter state; BLUETOOTH_CONNECT is the
         API 31+ dangerous permission requested at runtime - see BluetoothConnectPermission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".CompanionApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.EsdeCompanion"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.EsdeCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Lets the log/settings directory watchers rearm promptly once removable storage
             (e.g. an SD card holding the ES-DE folder) mounts after having been unavailable
             at app startup, or tear down cleanly on removal - see StorageMountReceiver /
             CLAUDE.md. android:exported is required (the system, a different UID, is the
             sender) but these MEDIA_* actions are platform protected-broadcast actions, not
             spoofable by third-party apps. <data android:scheme="file"/> is required for
             these actions to be delivered to a manifest-registered receiver at all. -->
        <receiver
            android:name=".data.storage.StorageMountReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <action android:name="android.intent.action.MEDIA_UNMOUNTED" />
                <action android:name="android.intent.action.MEDIA_EJECT" />
                <action android:name="android.intent.action.MEDIA_REMOVED" />
                <action android:name="android.intent.action.MEDIA_BAD_REMOVAL" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>

        <!-- Thor Settings (Ayn Thor-only: Lid Wake Guard, Auto FPS Mode, Task Killer, Volume
             Sync - see CLAUDE.md). The first AccessibilityService in this codebase; only ever
             bound if the user explicitly enables a Thor Settings toggle, and only shown/
             reachable there on an actual Ayn Thor device (see DeviceCheck.isAynThorDevice).
             Narrow config - see res/xml/thor_accessibility_service_config.xml - never
             requests window content. -->
        <service
            android:name=".data.thor.accessibility.CompanionAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/thor_accessibility_service_config" />
        </service>

        <!-- Exposes the downloaded update APK (private cache dir) to the system package
             installer - see ApkInstaller / res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>