<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Storage access is required to read ES-DE's es_log.txt and, later, media files.
        This is deliberately minimal for this initial slice: a hardcoded log path (see
        AppContainer) and manifest permission declarations only. Runtime permission
        requests - including the Android 11+ "All Files Access" flow - are not
        implemented yet. That is one of the iterative pieces described in CLAUDE.md,
        not part of this initial base app.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".CompanionApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.EsdeCompanion"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EsdeCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
